        "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.exe": true,
        "**/*.bin": true,
        "**/*.e:": true, 
        "**/.cph": true, 
        "**/.vscode": true,
        "**/bin": true,
        ".*": true,
    },

    "code-runner.executorMap": {
        "cpp": "cd $dir && g++ $fileName --std=c++14 -pipe -O2 -s -static -lm -x -Wall -Wextra -DLOCALONLY -o bin/$fileNameWithoutExt && $dirbin/$fileNameWithoutExt",
    },

    "C_Cpp.errorSquiggles": "disabled",

    "editor.fontFamily": "Fira Code, monospace",
    "terminal.integrated.fontFamily": "Fira Code",
    "editor.fontVariations": false,
    "editor.fontWeight": "460",
    "cph-ng.cache.cleanOnStartup": false,
    "cph-ng.cphCapable.enabled": true,
}